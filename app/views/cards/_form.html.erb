<%= form_with model: [deck, card], class: "space-y-4" do |f| %>
  <% if card.errors.any? %>
    <div class="p-3 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200">
      <ul class="text-red-700 dark:text-red-400 text-sm">
        <% card.errors.full_messages.each do |msg| %>
          <li>• <%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4">
    <div>
      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">
        Frente <span class="text-xs text-gray-400">(pergunta)</span>
      </label>
      <%= f.text_area :front, rows: 3, placeholder: "ex: What is the capital of France?",
            autofocus: true,
            class: "w-full px-4 py-2.5 rounded-xl border-2 border-blue-200 dark:border-blue-800
                    bg-blue-50 dark:bg-blue-950 text-gray-900 dark:text-gray-100
                    focus:border-brand-500 focus:outline-none transition-colors resize-none" %>
    </div>

    <div class="flex items-center justify-center text-gray-300 text-xl font-bold">⇅</div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">
        Verso <span class="text-xs text-gray-400">(resposta)</span>
      </label>
      <%= f.text_area :back, rows: 3, placeholder: "ex: Paris",
            class: "w-full px-4 py-2.5 rounded-xl border-2 border-emerald-200 dark:border-emerald-800
                    bg-emerald-50 dark:bg-emerald-950 text-gray-900 dark:text-gray-100
                    focus:border-brand-500 focus:outline-none transition-colors resize-none" %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit card.persisted? ? "Salvar" : "Adicionar Card",
          class: "flex-1 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700
                  text-white font-bold transition-colors cursor-pointer" %>
    <%= link_to "Cancelar", deck_path(deck),
          class: "px-5 py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800
                  text-gray-700 dark:text-gray-300 font-semibold hover:bg-gray-200 transition-colors" %>
  </div>
<% end %>
