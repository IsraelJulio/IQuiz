<%= form_with model: goal, class: "space-y-4" do |f| %>
  <% if goal.errors.any? %>
    <div class="p-3 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200">
      <ul class="text-red-700 dark:text-red-400 text-sm">
        <% goal.errors.full_messages.each do |msg| %>
          <li>• <%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Lista (deixe vazio para meta global)</label>
    <%= f.select :deck_id,
          [["Global (todas as listas)", ""]] + @decks.map { |d| [d.name, d.id] },
          { selected: goal.deck_id || "" },
          class: "w-full px-4 py-2.5 rounded-xl border-2 border-gray-200 dark:border-gray-700
                  bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100
                  focus:border-brand-500 focus:outline-none transition-colors" %>
  </div>

  <div>
    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Meta de % de acerto</label>
    <div class="flex items-center gap-2">
      <%= f.number_field :target_percentage, min: 1, max: 100, step: 1, placeholder: "80",
            class: "flex-1 px-4 py-2.5 rounded-xl border-2 border-gray-200 dark:border-gray-700
                    bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100
                    focus:border-brand-500 focus:outline-none transition-colors" %>
      <span class="text-gray-500 font-bold text-lg">%</span>
    </div>
  </div>

  <div>
    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Rótulo (opcional)</label>
    <%= f.text_field :label, placeholder: "ex: Dominar Vocabulário Básico",
          class: "w-full px-4 py-2.5 rounded-xl border-2 border-gray-200 dark:border-gray-700
                  bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100
                  focus:border-brand-500 focus:outline-none transition-colors" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit goal.persisted? ? "Salvar" : "Criar Meta",
          class: "flex-1 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700
                  text-white font-bold transition-colors cursor-pointer" %>
    <% if goal.persisted? %>
      <%= button_to "🗑️ Remover", goal_path(goal), method: :delete,
            data: { turbo_confirm: "Remover esta meta?" },
            class: "px-4 py-2.5 rounded-xl bg-red-50 dark:bg-red-900/30 text-red-700 font-semibold hover:bg-red-100 transition-colors" %>
    <% end %>
    <%= link_to "Cancelar", dashboard_path,
          class: "px-5 py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800
                  text-gray-700 dark:text-gray-300 font-semibold hover:bg-gray-200 transition-colors" %>
  </div>
<% end %>
