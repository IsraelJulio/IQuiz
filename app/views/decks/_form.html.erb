<%= form_with model: deck, class: "space-y-4" do |f| %>
  <% if deck.errors.any? %>
    <div class="p-3 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800">
      <ul class="text-red-700 dark:text-red-400 text-sm space-y-1">
        <% deck.errors.full_messages.each do |msg| %>
          <li>• <%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome da lista", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :name, placeholder: "ex: Inglês Básico",
          class: "w-full px-4 py-2.5 rounded-xl border-2 border-gray-200 dark:border-gray-700
                  bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100
                  focus:border-brand-500 focus:outline-none transition-colors" %>
  </div>

  <div>
    <%= f.label :description, "Descrição (opcional)", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_area :description, rows: 2, placeholder: "ex: Vocabulário do capítulo 1",
          class: "w-full px-4 py-2.5 rounded-xl border-2 border-gray-200 dark:border-gray-700
                  bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100
                  focus:border-brand-500 focus:outline-none transition-colors resize-none" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit deck.persisted? ? "Salvar" : "Criar Lista",
          class: "flex-1 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700
                  text-white font-bold transition-colors cursor-pointer" %>
    <%= link_to "Cancelar", deck.persisted? ? deck_path(deck) : decks_path,
          class: "px-5 py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800
                  text-gray-700 dark:text-gray-300 font-semibold hover:bg-gray-200 transition-colors" %>
  </div>
<% end %>
