<div class="space-y-6">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-extrabold">📚 Listas de Estudo</h1>
      <p class="text-gray-500 dark:text-gray-400 text-sm mt-0.5">Escolha uma lista para jogar</p>
    </div>
    <% if israel_logged_in? %>
      <div class="flex gap-2 flex-wrap">
        <%= link_to "📥 Importar CSV", import_new_deck_path,
              class: "px-4 py-2 rounded-xl bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300
                      font-semibold text-sm hover:bg-indigo-200 transition-colors" %>
        <%= link_to "+ Nova Lista", new_deck_path,
              class: "px-4 py-2 rounded-xl bg-brand-600 text-white font-bold text-sm
                      hover:bg-brand-700 transition-colors" %>
      </div>
    <% end %>
  </div>

  <% if @decks.empty? %>
    <div class="text-center py-20">
      <div class="text-6xl mb-4">📭</div>
      <p class="text-xl font-semibold text-gray-400">Nenhuma lista ainda.</p>
      <% if israel_logged_in? %>
        <p class="text-gray-400 mt-2">Crie sua primeira lista para começar!</p>
        <%= link_to "+ Criar lista", new_deck_path,
              class: "mt-4 inline-block px-6 py-3 rounded-xl bg-brand-600 text-white font-bold hover:bg-brand-700 transition-colors" %>
      <% end %>
    </div>
  <% else %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @decks.each_with_index do |deck, i| %>
        <%
          gradients = [
            "from-violet-500 to-purple-600",
            "from-blue-500 to-indigo-600",
            "from-emerald-500 to-teal-600",
            "from-orange-500 to-amber-600",
            "from-pink-500 to-rose-600",
            "from-cyan-500 to-blue-600",
          ]
          gradient = gradients[i % gradients.length]
        %>
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-md border border-gray-100 dark:border-gray-800
                    overflow-hidden hover:shadow-lg transition-shadow group">
          <!-- Color strip -->
          <div class="h-2 bg-gradient-to-r <%= gradient %>"></div>

          <div class="p-4 space-y-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h2 class="font-bold text-lg leading-tight"><%= deck.name %></h2>
                <% if deck.description.present? %>
                  <p class="text-gray-500 dark:text-gray-400 text-sm mt-0.5 line-clamp-2"><%= deck.description %></p>
                <% end %>
              </div>
              <span class="flex-shrink-0 text-2xl mt-0.5">🃏</span>
            </div>

            <div class="text-xs text-gray-400 dark:text-gray-500 font-medium">
              <%= deck.card_count %> card<%= deck.card_count == 1 ? "" : "s" %>
            </div>

            <div class="flex gap-2 flex-wrap pt-1">
              <%= link_to "▶ Jogar", new_game_session_path(deck_id: deck.id),
                    class: "flex-1 text-center py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700
                            text-white font-bold text-sm transition-colors active:scale-95 transform duration-100" %>
              <%= link_to "Ver", deck_path(deck),
                    class: "px-3 py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800
                            text-gray-700 dark:text-gray-300 font-semibold text-sm
                            hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors" %>
              <% if israel_logged_in? %>
                <%= link_to "✏️", edit_deck_path(deck),
                      class: "px-3 py-2.5 rounded-xl bg-yellow-50 dark:bg-yellow-900/30
                              text-yellow-700 dark:text-yellow-400 font-semibold text-sm
                              hover:bg-yellow-100 transition-colors" %>
                <%= button_to "🗑️", deck_path(deck), method: :delete,
                      data: { turbo_confirm: "Deletar a lista \"#{deck.name}\"? Esta ação não pode ser desfeita." },
                      class: "px-3 py-2.5 rounded-xl bg-red-50 dark:bg-red-900/30
                              text-red-700 dark:text-red-400 font-semibold text-sm
                              hover:bg-red-100 transition-colors" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
