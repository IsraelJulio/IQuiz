<div class="space-y-6">
  <!-- Header -->
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <%= link_to "← Listas", decks_path, class: "text-sm text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 mb-1 inline-block" %>
      <h1 class="text-2xl font-extrabold"><%= @deck.name %></h1>
      <% if @deck.description.present? %>
        <p class="text-gray-500 dark:text-gray-400 mt-1"><%= @deck.description %></p>
      <% end %>
      <p class="text-sm text-gray-400 mt-1"><%= @cards.count %> card<%= @cards.count == 1 ? "" : "s" %></p>
    </div>

    <div class="flex gap-2 flex-wrap">
      <%= link_to "▶ Jogar", new_game_session_path(deck_id: @deck.id),
            class: "px-4 py-2.5 rounded-xl bg-brand-600 text-white font-bold text-sm
                    hover:bg-brand-700 transition-colors" %>
      <% if israel_logged_in? %>
        <%= link_to "+ Card", new_deck_card_path(@deck),
              class: "px-4 py-2.5 rounded-xl bg-emerald-600 text-white font-bold text-sm
                      hover:bg-emerald-700 transition-colors" %>
        <%= link_to "📥 CSV", import_deck_path(@deck),
              class: "px-4 py-2.5 rounded-xl bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300
                      font-semibold text-sm hover:bg-indigo-200 transition-colors" %>
        <%= link_to "✏️ Editar", edit_deck_path(@deck),
              class: "px-4 py-2.5 rounded-xl bg-yellow-50 dark:bg-yellow-900/30
                      text-yellow-700 dark:text-yellow-400 font-semibold text-sm hover:bg-yellow-100 transition-colors" %>
      <% end %>
    </div>
  </div>

  <!-- Cards list -->
  <% if @cards.empty? %>
    <div class="text-center py-16 bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800">
      <div class="text-5xl mb-3">🃏</div>
      <p class="text-gray-400 font-medium">Nenhum card ainda.</p>
      <% if israel_logged_in? %>
        <%= link_to "+ Adicionar card", new_deck_card_path(@deck),
              class: "mt-3 inline-block px-5 py-2.5 rounded-xl bg-brand-600 text-white font-bold hover:bg-brand-700 transition-colors" %>
      <% end %>
    </div>
  <% else %>
    <div class="space-y-2">
      <% @cards.each do |card| %>
        <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-100 dark:border-gray-800
                    p-4 flex items-start justify-between gap-3 hover:shadow-sm transition-shadow">
          <div class="flex-1 min-w-0 grid grid-cols-2 gap-3">
            <div>
              <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Frente</p>
              <p class="text-gray-800 dark:text-gray-200 font-medium text-sm leading-snug"><%= card.front %></p>
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Verso</p>
              <p class="text-gray-600 dark:text-gray-400 text-sm leading-snug"><%= card.back %></p>
            </div>
          </div>
          <% if israel_logged_in? %>
            <div class="flex gap-1 flex-shrink-0">
              <%= link_to "✏️", edit_deck_card_path(@deck, card),
                    class: "p-1.5 rounded-lg bg-yellow-50 dark:bg-yellow-900/30 text-yellow-600
                            hover:bg-yellow-100 text-sm transition-colors" %>
              <%= button_to "🗑️", deck_card_path(@deck, card), method: :delete,
                    data: { turbo_confirm: "Remover este card?" },
                    class: "p-1.5 rounded-lg bg-red-50 dark:bg-red-900/30 text-red-600
                            hover:bg-red-100 text-sm transition-colors" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
