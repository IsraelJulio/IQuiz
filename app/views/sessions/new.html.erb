<div class="min-h-[70vh] flex items-center justify-center">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <div class="text-6xl mb-3">🔐</div>
      <h1 class="text-3xl font-extrabold text-brand-700 dark:text-brand-300">Login do Israel</h1>
      <p class="text-gray-500 dark:text-gray-400 mt-1">Digite a senha para continuar</p>
    </div>

    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-6 border border-gray-100 dark:border-gray-800">
      <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Senha</label>
          <%= f.password_field :password,
                autofocus: true,
                placeholder: "••••••",
                class: "w-full px-4 py-3 rounded-xl border-2 border-gray-200 dark:border-gray-700
                        bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100
                        focus:border-brand-500 focus:outline-none transition-colors text-lg" %>
        </div>

        <% if flash[:alert].present? %>
          <p class="text-red-600 dark:text-red-400 text-sm font-medium text-center">
            <%= flash[:alert] %>
          </p>
        <% end %>

        <%= f.submit "Entrar →",
              class: "w-full py-3 px-6 rounded-xl bg-brand-600 hover:bg-brand-700
                      text-white font-bold text-lg transition-colors cursor-pointer
                      active:scale-95 transform duration-100" %>
      <% end %>
    </div>

    <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-4">
      Sem conta? <%= link_to "Continue como Player One →", root_path, class: "text-brand-600 dark:text-brand-400 font-medium hover:underline" %>
    </p>
  </div>
</div>
