<div class="space-y-8">

  <!-- Hero / Quick Play -->
  <div class="bg-gradient-to-br from-brand-600 to-indigo-700 rounded-2xl p-6 text-white shadow-xl">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-2xl font-extrabold">
          Olá, <%= current_user.israel? ? "Israel 👋" : "Player One 👾" %>!
        </h1>
        <p class="text-brand-100 mt-1 text-sm">
          <%= current_user.total_points.round(1) %> pontos totais ·
          <%= current_user.overall_accuracy %>% de acerto global
        </p>
      </div>
      <%= link_to "▶ Jogar Agora", new_game_session_path,
            class: "px-6 py-3 bg-white text-brand-700 font-extrabold rounded-xl
                    hover:bg-brand-50 transition-colors shadow-md text-sm" %>
    </div>

    <!-- Direction stats -->
    <div class="grid grid-cols-2 gap-3 mt-5">
      <div class="bg-white/20 rounded-xl p-3 backdrop-blur">
        <p class="text-xs text-brand-200 font-semibold mb-1">📖→💡 Frente→Verso</p>
        <p class="text-xl font-extrabold"><%= @front_points.round(1) %> pts</p>
        <p class="text-sm text-brand-100"><%= @front_accuracy %>% acerto</p>
      </div>
      <div class="bg-white/20 rounded-xl p-3 backdrop-blur">
        <p class="text-xs text-brand-200 font-semibold mb-1">💡→📖 Verso→Frente</p>
        <p class="text-xl font-extrabold"><%= @back_points.round(1) %> pts</p>
        <p class="text-sm text-brand-100"><%= @back_accuracy %>% acerto</p>
      </div>
    </div>
  </div>

  <!-- Goals -->
  <% if @goals.any? %>
    <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-extrabold">🎯 Metas</h2>
        <% if israel_logged_in? %>
          <%= link_to "+ Meta", new_goal_path,
                class: "text-sm text-brand-600 dark:text-brand-400 font-semibold hover:underline" %>
        <% end %>
      </div>
      <div class="space-y-3">
        <% @goals.each do |goal| %>
          <%
            progress = goal.current_progress(current_user)
            achieved = goal.achieved?(current_user)
            pct = [progress / goal.target_percentage * 100, 100].min.round
          %>
          <div class="space-y-1">
            <div class="flex items-center justify-between text-sm">
              <span class="font-medium flex items-center gap-1">
                <%= achieved ? "✅" : "🎯" %>
                <%= goal.display_label %>
              </span>
              <span class="text-gray-400"><%= progress.round(1) %>% / <%= goal.target_percentage.to_i %>%</span>
            </div>
            <div class="h-3 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all duration-700 <%= achieved ? 'bg-emerald-500' : 'bg-brand-500' %>"
                   style="width: <%= pct %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <% if israel_logged_in? %>
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-dashed border-gray-200 dark:border-gray-700 p-5 text-center">
        <p class="text-gray-400 text-sm mb-2">Sem metas definidas ainda.</p>
        <%= link_to "+ Criar Meta", new_goal_path,
              class: "px-4 py-2 rounded-xl bg-brand-600 text-white font-bold text-sm hover:bg-brand-700 transition-colors" %>
      </div>
    <% end %>
  <% end %>

  <!-- Heatmap Calendar -->
  <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-extrabold">📅 Calendário</h2>
      <div class="flex items-center gap-2 text-xs text-gray-400">
        <span>menos</span>
        <div class="flex gap-1">
          <div class="w-3 h-3 rounded-sm bg-gray-100 dark:bg-gray-800"></div>
          <div class="w-3 h-3 rounded-sm bg-brand-200 dark:bg-brand-900"></div>
          <div class="w-3 h-3 rounded-sm bg-brand-400 dark:bg-brand-600"></div>
          <div class="w-3 h-3 rounded-sm bg-brand-600 dark:bg-brand-400"></div>
        </div>
        <span>mais</span>
      </div>
    </div>
    <%= render "heatmap" %>
  </div>

  <!-- Day detail placeholder -->
  <div id="day-detail"></div>

  <!-- Achievements -->
  <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm p-5">
    <h2 class="text-lg font-extrabold mb-4">🏆 Conquistas</h2>
    <%= render "achievements" %>
  </div>

  <!-- Session History -->
  <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <h2 class="text-lg font-extrabold">📋 Histórico de Sessões</h2>
    </div>

    <!-- Filters -->
    <%= form_with url: dashboard_path, method: :get, class: "flex gap-2 flex-wrap mb-4", data: { turbo_frame: "_top" } do |f| %>
      <select name="filter_user"
              onchange="this.form.requestSubmit()"
              class="px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800
                     text-sm text-gray-700 dark:text-gray-300 focus:outline-none focus:border-brand-500">
        <option value="">Todos os jogadores</option>
        <option value="<%= User::PLAYER_ONE_ID %>" <%= "selected" if @filter_user == User::PLAYER_ONE_ID.to_s %>>Player One</option>
        <option value="<%= User::ISRAEL_ID %>" <%= "selected" if @filter_user == User::ISRAEL_ID.to_s %>>Israel</option>
      </select>

      <select name="filter_deck"
              onchange="this.form.requestSubmit()"
              class="px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800
                     text-sm text-gray-700 dark:text-gray-300 focus:outline-none focus:border-brand-500">
        <option value="">Todas as listas</option>
        <% @active_decks.each do |deck| %>
          <option value="<%= deck.id %>" <%= "selected" if @filter_deck == deck.id.to_s %>><%= deck.name %></option>
        <% end %>
      </select>

      <select name="filter_mode"
              onchange="this.form.requestSubmit()"
              class="px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800
                     text-sm text-gray-700 dark:text-gray-300 focus:outline-none focus:border-brand-500">
        <option value="">Todos os modos</option>
        <% GameSession::MODES.each do |mode| %>
          <option value="<%= mode %>" <%= "selected" if @filter_mode == mode %>><%= mode.tr("_", " ").capitalize %></option>
        <% end %>
      </select>

      <select name="filter_direction"
              onchange="this.form.requestSubmit()"
              class="px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800
                     text-sm text-gray-700 dark:text-gray-300 focus:outline-none focus:border-brand-500">
        <option value="">Ambas direções</option>
        <option value="front" <%= "selected" if @filter_direction == "front" %>>Frente→Verso</option>
        <option value="back"  <%= "selected" if @filter_direction == "back"  %>>Verso→Frente</option>
      </select>
    <% end %>

    <%= render "sessions_table", sessions: @sessions %>
  </div>

</div>
