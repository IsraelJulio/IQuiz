<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
  <% @achievements.each do |achievement| %>
    <% ua = @user_achievements[achievement.id] %>
    <% unlocked = ua.present? %>

    <div class="flex flex-col items-center gap-1 p-3 rounded-xl text-center
                transition-all duration-200
                <%= unlocked ? 'bg-yellow-50 dark:bg-yellow-950/50 border border-yellow-200 dark:border-yellow-800 shadow-sm' : 'bg-gray-50 dark:bg-gray-800/50 border border-gray-100 dark:border-gray-800 opacity-50' %>"
         title="<%= achievement.description %><%= unlocked ? " · #{ua.unlocked_at.strftime('%d/%m/%Y')}" : '' %>">
      <span class="text-3xl <%= unlocked ? '' : 'grayscale' %>"><%= achievement.icon %></span>
      <p class="text-xs font-semibold leading-tight text-gray-700 dark:text-gray-300"><%= achievement.name %></p>
      <% if unlocked %>
        <p class="text-[10px] text-yellow-600 dark:text-yellow-400 font-medium"><%= ua.unlocked_at.strftime("%d/%m") %></p>
      <% else %>
        <p class="text-[10px] text-gray-400">🔒</p>
      <% end %>
    </div>
  <% end %>
</div>
